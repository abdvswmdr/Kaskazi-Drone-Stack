<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kaskazi_drone</name>
  <version>0.1.0</version>
  <description>Kaskazi drone project - ArduPilot, Gazebo, and ROS2 integration for autonomous drone development</description>
  
  <maintainer email="kaskazi@example.com">Kaskazi Developer</maintainer>
  <license>MIT</license>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- ROS2 Core Dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>action_msgs</depend>

  <!-- MAVROS Dependencies -->
  <depend>mavros</depend>
  <depend>mavros_msgs</depend>
  
  <!-- Action Interface Generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ArduPilot DDS Integration -->
  <depend>builtin_interfaces</depend>
  <depend>micro_ros_agent</depend>
  
  <!-- Gazebo Integration -->
  <depend>gazebo_ros_pkgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>xacro</depend>
  
  <!-- Launch and Config -->
  <depend>launch</depend>
  <depend>launch_ros</depend>
  
  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>