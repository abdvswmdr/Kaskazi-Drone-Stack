<?xml version="1.0" encoding="utf-8"?>
<!-- Enhanced Crazyflie URDF for ArduPilot-Gazebo Integration -->
<robot name="crazyflie_gazebo">
  
  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-2.63791012241991E-05 -0.000268052705446983 0.00191074112200795" rpy="0 0 0" />
      <mass value="0.0191917431990065" />
      <inertia
        ixx="8.93713430198133E-07"
        ixy="-3.57863594302582E-22"
        ixz="-1.26615970453137E-10"
        iyy="1.00507341216179E-06"
        iyz="1.66710668680818E-22"
        izz="1.46956848000142E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Rotor 1 -->
  <link name="rotor_1_link">
    <inertial>
      <origin xyz="-2.6852E-10 2.5151E-10 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025712" />
      <inertia
        ixx="2.6852E-08"
        ixy="-1.8324E-08"
        ixz="4.193E-18"
        iyy="1.3639E-08"
        iyz="1.231E-18"
        izz="4.0185E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_1_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_1_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_1_joint" type="continuous">
    <origin xyz="0.031643 -0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_1_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Rotor 2 -->
  <link name="rotor_2_link">
    <inertial>
      <origin xyz="-8.1567E-10 -1.248E-09 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025708" />
      <inertia
        ixx="1.6525E-08"
        ixy="1.911E-08"
        ixz="-8.4355E-18"
        iyy="2.3941E-08"
        iyz="1.2492E-17"
        izz="4.016E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_2_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_2_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_2_joint" type="continuous">
    <origin xyz="-0.031643 -0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_2_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Rotor 3 -->
  <link name="rotor_3_link">
    <inertial>
      <origin xyz="9.2574E-10 1.1687E-09 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025708" />
      <inertia
        ixx="2.0046E-08"
        ixy="1.9465E-08"
        ixz="7.269E-18"
        iyy="2.042E-08"
        iyz="-1.3178E-17"
        izz="4.016E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_3_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_3_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_3_joint" type="continuous">
    <origin xyz="0.031643 0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_3_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Rotor 4 -->
  <link name="rotor_4_link">
    <inertial>
      <origin xyz="-3.6475E-10 4.8156E-11 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025712" />
      <inertia
        ixx="3.9721E-08"
        ixy="3.5294E-10"
        ixz="2.6212E-18"
        iyy="7.7057E-10"
        iyz="3.4849E-18"
        izz="4.0185E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_4_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://crazyflie/meshes/rotor_4_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_4_joint" type="continuous">
    <origin xyz="-0.031643 0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_4_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Gazebo Plugins -->
  
  <!-- ArduPilot SITL Plugin - Main communication with ArduPilot -->
  <gazebo>
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.14159 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.14159 0 0</gazeboXYZToNED>
      <imuName>imu_link</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      
      <!-- Motor configuration for quadcopter -->
      <control channel="0">
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>
      
      <control channel="1">
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>
      
      <control channel="2">
        <jointName>rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>
      
      <control channel="3">
        <jointName>rotor_4_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838.0</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
      </control>
    </plugin>
  </gazebo>

  <!-- IMU Plugin -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000.0</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_imu_plugin.so">
        <robotNamespace/>
        <topicName>/imu</topicName>
        <bodyName>base_link</bodyName>
        <updateRateHZ>1000.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>base_link</frameName>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- GPS Plugin -->
  <gazebo>
    <plugin name="gps_plugin" filename="libgazebo_gps_plugin.so">
      <robotNamespace/>
      <gpsNoise>true</gpsNoise>
      <gpsXYRandomWalk>2.0</gpsXYRandomWalk>
      <gpsZRandomWalk>4.0</gpsZRandomWalk>
      <gpsXYNoiseDensity>2.0e-4</gpsXYNoiseDensity>
      <gpsZNoiseDensity>4.0e-4</gpsZNoiseDensity>
      <gpsVXYRandomWalk>0.2</gpsVXYRandomWalk>
      <gpsVZRandomWalk>0.4</gpsVZRandomWalk>
      <gpsVXYNoiseDensity>2.0e-5</gpsVXYNoiseDensity>
      <gpsVZNoiseDensity>4.0e-5</gpsVZNoiseDensity>
    </plugin>
  </gazebo>

  <!-- Magnetometer Plugin -->
  <gazebo>
    <plugin name="magnetometer_plugin" filename="libgazebo_magnetometer_plugin.so">
      <robotNamespace/>
      <pubRate>100</pubRate>
      <noiseDensity>0.0004</noiseDensity>
      <randomWalk>6.4e-06</randomWalk>
      <biasCorrelationTime>600</biasCorrelationTime>
      <magTopic>/mag</magTopic>
    </plugin>
  </gazebo>

  <!-- Barometer Plugin -->
  <gazebo>
    <plugin name="barometer_plugin" filename="libgazebo_barometer_plugin.so">
      <robotNamespace/>
      <pubRate>50</pubRate>
      <baroTopic>/baro</baroTopic>
    </plugin>
  </gazebo>

</robot>