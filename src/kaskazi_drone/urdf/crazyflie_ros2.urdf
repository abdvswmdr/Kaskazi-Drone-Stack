<?xml version="1.0" encoding="utf-8"?>
<!-- ROS2-compatible Crazyflie URDF based on original SolidWorks export -->
<robot name="crazyflie">
  
  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-2.63791012241991E-05 -0.000268052705446983 0.00191074112200795" rpy="0 0 0" />
      <mass value="0.0191917431990065" />
      <inertia
        ixx="8.93713430198133E-07"
        ixy="-3.57863594302582E-22"
        ixz="-1.26615970453137E-10"
        iyy="1.00507341216179E-06"
        iyz="1.66710668680818E-22"
        izz="1.46956848000142E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/base_link.STL" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Rotor 1 Link -->
  <link name="rotor_1_link">
    <inertial>
      <origin xyz="-2.6852E-10 2.5151E-10 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025712" />
      <inertia
        ixx="2.6852E-08"
        ixy="-1.8324E-08"
        ixz="4.193E-18"
        iyy="1.3639E-08"
        iyz="1.231E-18"
        izz="4.0185E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_1_link.STL" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_1_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_1_joint" type="continuous">
    <origin xyz="0.031643 -0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_1_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Rotor 2 Link -->
  <link name="rotor_2_link">
    <inertial>
      <origin xyz="-8.1567E-10 -1.248E-09 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025708" />
      <inertia
        ixx="1.6525E-08"
        ixy="1.911E-08"
        ixz="-8.4355E-18"
        iyy="2.3941E-08"
        iyz="1.2492E-17"
        izz="4.016E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_2_link.STL" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_2_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_2_joint" type="continuous">
    <origin xyz="-0.031643 -0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_2_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Rotor 3 Link -->
  <link name="rotor_3_link">
    <inertial>
      <origin xyz="9.2574E-10 1.1687E-09 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025708" />
      <inertia
        ixx="2.0046E-08"
        ixy="1.9465E-08"
        ixz="7.269E-18"
        iyy="2.042E-08"
        iyz="-1.3178E-17"
        izz="4.016E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_3_link.STL" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_3_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_3_joint" type="continuous">
    <origin xyz="0.031643 0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_3_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Rotor 4 Link -->
  <link name="rotor_4_link">
    <inertial>
      <origin xyz="-3.6475E-10 4.8156E-11 -0.0016763" rpy="0 0 0" />
      <mass value="0.00025712" />
      <inertia
        ixx="3.9721E-08"
        ixy="3.5294E-10"
        ixz="2.6212E-18"
        iyy="7.7057E-10"
        iyz="3.4849E-18"
        izz="4.0185E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_4_link.STL" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.10196 0.10196 0.10196 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kaskazi_drone/crazyflie/meshes/rotor_4_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rotor_4_joint" type="continuous">
    <origin xyz="-0.031643 0.031643 0.01385" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rotor_4_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- Gazebo Materials -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  
  <gazebo reference="rotor_1_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  
  <gazebo reference="rotor_2_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  
  <gazebo reference="rotor_3_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  
  <gazebo reference="rotor_4_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

</robot>